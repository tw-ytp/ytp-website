---
import site from '../data/site.json';
import season from '../data/season.json';
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SearchDialog from '../components/SearchDialog.astro';
// brand：分頁標題的後綴。青年圖靈++ 的頁面傳入「青年圖靈++」，其餘預設為站名。
interface Props { title: string; description?: string; brand?: string }
const { title, description = site.description, brand = site.shortName } = Astro.props;
const path = Astro.url.pathname;
// [href, 標籤, 軌道, 其他也算「目前頁」的路徑前綴]
const nav: [string, string, string, string[]][] = [
  ['/', '首頁', '', []],
  [`/cohorts/${season.edition}/`, `第 ${season.edition} 屆`, 'main', ['/program/']],   // 當屆，依 season.json 自動更新
  ['/turing-plus/', '青年圖靈++', 'plus', []],
  ['/projects/', '歷屆成果', '', ['/cohorts/']],
  ['/stories/', '學員故事', '', []],
  ['/news/', '最新消息', '', []],
  ['/program/faq/', '常見問題', '', []],
  ['/about/', '關於 YTP', '', []],
];
// 取最長相符的前綴：/program/faq/ 只點亮「常見問題」，/cohorts/7/ 點亮「歷屆成果」，/cohorts/11/ 點亮「第 11 屆」
const score = ([href, , , more]: typeof nav[number]) =>
  href === '/' ? (path === '/' ? 1 : 0) : Math.max(0, ...[href, ...more].map(h => (path.startsWith(h) ? h.length : 0)));
const active = nav.reduce((best, n) => (score(n) > score(best) ? n : best), nav[0]);
const activeHref = score(active) > 0 ? active[0] : '';
// Pagefind 的「類型」篩選：依路徑判定，與 SearchDialog.astro 的 TYPE_ORDER 對應。404 不進索引。
const pageType = path.startsWith('/projects/') ? '專題'
  : path.startsWith('/news/') ? '最新消息'
  : path.startsWith('/stories/') ? '學員故事'
  : path.startsWith('/program/faq/') ? '常見問題'
  : path.startsWith('/turing-plus/') ? '青年圖靈++'
  : path.startsWith('/cohorts/') || path.startsWith('/program/') ? '計畫'
  : path.startsWith('/resources/') || path.startsWith('/downloads/') ? '資源'
  : path.startsWith('/en/') ? 'English'
  : '其他';
const indexable = !/^\/404/.test(path) && import.meta.env.PUBLIC_NOINDEX !== 'true';
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{`${title}｜${brand}`}</title>
  <meta name="description" content={description} />
  <meta name="google-site-verification" content="kR8ucgzo94lq4A5aDVxaDlI619hJmF0zpHnf2zooS8c" />
  {import.meta.env.PUBLIC_NOINDEX === 'true' && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={site.name} />
  <link rel="canonical" href={new URL(path, site.url)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {/* 字型：非阻塞載入。Google Fonts 的 CSS 約 170 KiB（每個字重切成百餘個 unicode-range 區段），
      若用一般 <link rel="stylesheet"> 會擋住首次繪製，行動版 FCP 曾量到 8.8 s。
      改為 preload + onload 切換：先用系統中文字體畫出頁面，字型到了再換（font-display: swap）。
      字重 5 → 3：500 由 400 代、900 由 800 代，瀏覽器依 CSS 字重比對規則自動選最近的。 */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700;800&display=swap" /></noscript>
  <ClientRouter />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="YTP 少年圖靈計畫 首頁">
        <img class="brand-logo brand-logo-light" src="/brand/logo_ytp_rgb.png" width="150" height="45" alt="YTP 少年圖靈計畫 Young Turing Program" />
        <img class="brand-logo brand-logo-dark" src="/brand/ytp-logo-white.png" width="142" height="45" alt="" aria-hidden="true" />
      </a>
      <div class="header-actions">
        <button type="button" class="search-btn" data-search-open aria-label="搜尋（Ctrl+K）" title="搜尋（Ctrl+K）">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span class="search-btn-text">搜尋</span><kbd class="search-btn-kbd">⌘K</kbd>
        </button>
        <button class="menu-btn" aria-expanded="false" aria-controls="nav">選單</button>
      </div>
      <nav class="nav" id="nav" aria-label="主選單">
        {nav.map(([href, label, track]) => (
          <a href={href} class={track ? `nav-${track}` : undefined} aria-current={href === activeHref ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main data-pagefind-body={indexable ? '' : undefined} data-pagefind-filter={indexable ? `type:${pageType}` : undefined}><slot /></main>
  <SearchDialog />
  <footer class="site-footer">
    <div class="wrap grid c4">
      <div>
        <h3>{site.shortName}</h3>
        <p>主辦：{site.organizer}<br/>協辦：{site.coOrganizers.join('、')}</p>
      </div>
      <div>
        <h3>聯絡</h3>
        <ul><li><a href={`mailto:${site.email}`}>{site.email}</a></li></ul>
      </div>
      <div>
        <h3>社群</h3>
        <ul>
          <li><a href={site.social.facebook} rel="noopener">Facebook 社團</a></li>
          <li><a href={site.social.discord} rel="noopener">Discord</a></li>
          {site.social.youtube ? <li><a href={site.social.youtube} rel="noopener">YouTube</a></li> : <li class="muted">YouTube（待補網址）</li>}
          {site.social.github ? <li><a href={site.social.github} rel="noopener">GitHub</a></li> : <li class="muted">GitHub（待補網址）</li>}
        </ul>
      </div>
      <div>
        <h3>更多</h3>
        <ul>
          <li><a href="/about/">關於 YTP</a></li>
          <li><a href="/resources/">備賽資源</a></li>
          <li><a href="/cohorts/">歷屆資訊</a></li>
          <li><a href="/downloads/">簡章與檔案下載</a></li>
          <li><a href="/en/">English</a></li>
        </ul>
        <p class="small" style="margin-top:12px">© {new Date().getFullYear()} Young Turing Program</p>
      </div>
    </div>
  </footer>
  <script>
    const bindMenu = () => {
      const b = document.querySelector('.menu-btn'), n = document.getElementById('nav');
      b?.addEventListener('click', () => { const o = n.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
    };
    bindMenu();
    document.addEventListener('astro:after-swap', bindMenu);
  </script>
</body>
</html>
