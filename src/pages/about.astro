---
/** 關於 YTP。正文來自 src/content/pages/about.md（後台「網站頁面」可改）；影響力數字、主辦協辦、聯絡為資料檔，固定接在正文之後。 */
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import Banner from '../components/Banner.astro';
import site from '../data/site.json';
import stats from '../data/stats.json';
import { getPage } from '../lib/pages';
const page = await getPage('about');
---
<Base title={page.nav ?? page.title} description={page.description}>
  <Banner image={page.banner} title={page.title} lead={page.lead} />
  <div class="wrap prose">
    <page.Content />
    <h2>影響力</h2>
    <div class="grid c4">
      {stats.items.map(s => <div class="stat"><b>{s.value ?? '—'}</b><span>{s.label}</span>{s.value == null && <Todo>{s.todo}</Todo>}</div>)}
    </div>
    <h2>主辦與協辦</h2>
    <p>主辦單位：{site.organizer}<br/>協辦單位：{site.coOrganizers.join('、')}</p>
    <Todo>補上歷屆指導教授、企業導師名單與合作單位 logo（舊站無此內容）。</Todo>
    <h2>聯絡</h2>
    <p>YTP 少年圖靈計畫執行小組：<a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
</Base>
