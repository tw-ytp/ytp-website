---
/** 檔案下載。「第 N 屆」兩個檔案來自 season.json；其餘清單來自 src/content/pages/downloads.md（後台「網站頁面」可改）。 */
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import Banner from '../components/Banner.astro';
import season from '../data/season.json';
import { getPage } from '../lib/pages';
const page = await getPage('downloads');
---
<Base title={page.title} description={page.description}>
  <Banner title={page.title} lead={page.lead} />
  <div class="wrap prose">
    <h2>第 {season.edition} 屆</h2>
    <ul>
      <li><a href={season.documents.brochure.url}>{season.documents.brochure.label}（PDF）</a></li>
      <li><a href={season.documents.faq.url}>{season.documents.faq.label}（PDF）</a>｜<a href="/program/faq/">網頁版</a></li>
    </ul>
    <page.Content />
    <Todo>補公文範本、A4 海報、社群宣傳圖與文字。</Todo>
    <Todo>所有 PDF 已存於站內 /legacy/，檔名沿用原始中文名以保留對照；新檔案請改放 public/downloads/（後台「下載檔案」上傳）。</Todo>
  </div>
</Base>
