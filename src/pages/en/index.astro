---
/** English。Season track 為動態；其餘文字來自 src/content/pages/en.md（後台「網站頁面」可改）。 */
import Base from '../../layouts/Base.astro';
import Todo from '../../components/Todo.astro';
import Track from '../../components/Track.astro';
import Banner from '../../components/Banner.astro';
import season from '../../data/season.json';
import { getPage } from '../../lib/pages';
const page = await getPage('en');
---
<Base title={page.nav ?? page.title} description={page.description}>
  <Banner image={page.banner} title={page.title} lead={page.lead} />
  <div class="wrap prose">
    <h2>Season {season.year}</h2>
    <Track />
    <page.Content />
    <Todo>Confirm with the organizing team whether iYTP is still running. If yes, add current dates, brochure and registration link; if not, rewrite that section as an archive and link the 2022 APAC past exam.</Todo>
  </div>
</Base>
