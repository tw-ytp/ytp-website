---
import Base from '../layouts/Base.astro';
import YearTimeline from '../components/YearTimeline.astro';
import markPlusDark from '../assets/marks/mark-plus-dark.svg';
import season from '../data/season.json';
import stats from '../data/stats.json';
import { getCollection } from 'astro:content';
import { fmtRange } from '../lib/cohort';

const projects = (await getCollection('projects', p => p.data.status !== 'todo' && p.data.source === 'stage2-project'))
  .filter(p => p.data.rank === 1).sort((a, b) => b.data.year - a.data.year || a.id.localeCompare(b.id)).slice(0, 4);
const stories = (await getCollection('stories')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id)).slice(0, 1);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id)).slice(0, 3);

const e = season.edition, y = season.year;
const cohort = (await getCollection('cohorts')).find(c => c.data.edition === e)!;
const plus = (await getCollection('turingPlus')).sort((a, b) => a.id.localeCompare(b.id));
const plusNext = plus.find(h => h.data.state !== 'archived') ?? plus.at(-1)!;       // 下一場（或最近一場）
const plusLast = [...plus].reverse().find(h => h.data.state === 'archived');         // 最近辦完的一場
const plusState = { archived: '已結束', upcoming: '即將舉行', planning: '籌備中' };
const shortTitle = (s: string) => s.split('：')[0];
const hero = {
  registration: { kicker: `第 ${e} 屆 · ${y}`, h: '報名開跑', sub: `${season.registration.close} 截止。3 人一組（國中組 2–3 人），不收報名費。`,
    ctas: [['/program/apply/', '立即報名', ''], ['/program/', '看計畫全覽', 'ghost']] },
  preliminary: { kicker: `第 ${e} 屆 · ${y}`, h: '線上初賽準備中', sub: `${season.stages[1].date}，台灣時間下午，人在哪裡都能參加。`,
    ctas: [['/resources/past-exams/', '練考古題', ''], ['/program/rules/', '看規則', 'ghost']] },
  camp: { kicker: `第 ${e} 屆 · ${y}`, h: '程式挑戰營即將舉行', sub: `${season.stages[2].date}，台北實體賽。晉級通知已寄至隊長信箱。`,
    ctas: [['/news/', '看最新公告', ''], ['/program/faq/', '交通補助與設備 FAQ', 'ghost']] },
  hackathon: { kicker: `第 ${e} 屆 · ${y}`, h: `YTP${y}H2黑客松進行中`, sub: `${season.stages[3].date} 一日實體賽。限本屆挑戰營高中組晉級隊伍。`,
    ctas: [[season.hackathonUrl, `YTP${y}H2黑客松`, ''], [`/cohorts/${e}/`, `第 ${e} 屆時程`, 'ghost']] },
  offseason: { kicker: `第 ${e} 屆回顧`, h: '下一屆，3 月見', sub: `第 ${e + 1} 屆預計 ${y + 1} 年 3 月開放報名；YTP${y + 1}黑客松預計 ${y + 1} 年上半年舉辦。先看看考古題和歷屆專題吧。`,
    ctas: [['/resources/', '備賽資源', ''], ['/projects/', '歷屆專題', 'ghost']] },
}[season.phase];
// 首頁底圖：平面程式碼晶格，Claude Design 方案 6 的 artboard 直接輸出（同種子、同字型；輸出工具頁「晶格底圖輸出」）。
const heroBg = { src: '/banners/home-lattice-1800.webp', srcSmall: '/banners/home-lattice-900.webp', dim: 0 };   // 圖檔即設計稿方案 6 的 artboard 輸出（光帶、暗角已在圖內），網站不再疊色
---
<Base title="首頁" description="為台灣培育世界級軟體人才。國中、高中職五專學生的程式競賽、專題實作、黑客松與海外參訪計畫，自 2016 年起舉辦。">
  {/* 首頁 Hero「照片全幅」版：整幅程式碼晶格底圖 + 置中文字。 */}
  <section class="section hero banner banner-photo" id="hero" style={`--dim:${heroBg.dim}`}>
    <picture class="banner-bg" aria-hidden="true">
      <source media="(min-width: 760px)" srcset={heroBg.src} />
      <img src={heroBg.srcSmall} width="900" height="450" alt="" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <div class="wrap banner-body hero-photo-body">
      <img class="hero-logo" src="/brand/ytp-logo-white.png" width="184" height="59" alt="YTP 少年圖靈計畫 Young Turing Program" loading="eager" />
      <h1 class="hero-title"><a href={`/cohorts/${e}/`}><span class="nowrap"><span class="ytp">YTP</span>少年圖靈計畫</span> <span class="nowrap slot">第 <span class="num">{e}</span> 屆・<span class="num">{y}</span></span></a></h1>
      <p class="hero-status">{hero.h}</p>
      <p class="lead">{hero.sub}</p>
      <div class="btn-row">
        {hero.ctas.map(([href, label, cls]) => <a class={`btn ${cls}`} href={href}>{label}</a>)}
      </div>
    </div>
  </section>
  <section class="hero-plus-band">
    <div class="wrap">
      <p class="hero-title"><a href="/turing-plus/"><img class="hero-mark" src={markPlusDark.src} width="32" height="24" alt="" />青年圖靈<span class="pp">++</span></a></p>
      <p class="hero-status"><a href={`/turing-plus/${plusNext.id}/`}>{shortTitle(plusNext.data.title)}</a>
        <span class="hero-meta">｜{plusNext.data.start ? fmtRange(plusNext.data.start, plusNext.data.end) : plusNext.data.period.replace(/（確切日期待公布）/, '')}｜{plusState[plusNext.data.state]}</span></p>
      {plusLast && plusLast.id !== plusNext.id && <p class="hero-meta"><a href={`/turing-plus/${plusLast.id}/`}>{shortTitle(plusLast.data.title)} 得獎作品</a></p>}
    </div>
  </section>

  <section class="section alt" aria-labelledby="timeline-h">
    <div class="wrap">
      <h2 id="timeline-h">{y}–{y + 1} 年度時程</h2>
      <YearTimeline edition={e} />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid c3">
      <div class="rule-left">
        <h3>參加對象</h3>
        <p>國內註冊之公私立國中（含小六升國中）與高中職五專一至三年級（含國三升高中）在學學生。</p>
      </div>
      <div class="rule-left">
        <h3>三階段歷程</h3>
        <p>線上初賽、台北實體挑戰營；高中組晉級隊伍再進入 YTP{y}H2黑客松，完成六場賽前培訓後，12 月 12 日黑客松競賽優勝者將取得隔年海外參訪選拔資格。</p>
      </div>
      <div class="rule-left">
        <h3>報名方式</h3>
        <p>高中職五專組 3 人一組、國中組 2–3 人一組，可跨校跨年級。報名期間線上填表即可。<a href="/program/faq/">常見問題</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{stats.sinceYear}–{y} 成果</h2>
      <div class="grid c3 stats">
        {stats.items.map(s => (
          <div class="stat">
            <b>{s.prefix && <small class="pre">{s.prefix}</small>}{s.value}{s.unit && <small>{s.unit}</small>}</b><span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>第 1–10 屆 專題實作第一名</h2>
      <ul class="list">
        {projects.map(p => (
          <li>
            <span class="meta">第 {p.data.edition} 屆・{p.data.year}</span><br/>
            <a href={`/projects/${p.id}/`}><b>{p.data.title}</b></a>
            <div class="meta">{p.data.members.map(m => `${m.name}（${m.school}）`).join('、')}</div>
          </li>
        ))}
      </ul>
      <div class="btn-row"><a class="btn ghost" href="/projects/">全部專題</a></div>
    </div>
  </section>

  {stories.map(s => (
    <section class="section">
      <div class="wrap grid c2">
        <div>
          <h2>學員故事</h2>
          <p class="lead">「{s.body?.replace(/^#.*$/gm, '').replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/<!--[\s\S]*?-->/g, '').trim().split('。')[0]}。」</p>
          <p class="meta">{s.data.author}，{s.data.school}，{s.data.trip}</p>
          <a href={`/stories/${s.id}/`}>讀全文</a>
        </div>
        <div>
          <h2>最新消息</h2>
          <ul class="list">
            {news.map(n => <li><span class="meta">{n.data.date.toISOString().slice(0,10)}</span><br/><a href={`/news/${n.id}/`}>{n.data.title}</a></li>)}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <section class="section alt">
    <div class="wrap">
      <h2>社群</h2>
      <p class="lead"><a href="https://www.facebook.com/groups/1527998927505701/" rel="noopener">追蹤 FB 社團</a>｜<a href="https://discord.gg/KpqC6CEthk" rel="noopener">加入 Discord</a></p>
    </div>
  </section>
</Base>
