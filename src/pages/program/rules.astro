---
/** 時程與競賽規則。「第 N 屆時程」表來自 season.json；其餘正文來自 src/content/pages/rules.md（後台「網站頁面」可改）。 */
import Base from '../../layouts/Base.astro';
import Todo from '../../components/Todo.astro';
import PageHead from '../../components/PageHead.astro';
import season from '../../data/season.json';
import { getPage } from '../../lib/pages';
const page = await getPage('rules');
---
<Base title={page.title} description={page.description}>
  <PageHead crumb={page.crumb} title={page.title} lead={page.lead} />
  <div class="wrap prose">
    <h2>第 {season.edition} 屆時程</h2>
    <table>
      <tbody>{season.stages.map(s => <tr><th>{s.label}</th><td>{s.date}</td><td>{s.groups}</td></tr>)}</tbody>
    </table>
    <Todo>第 11 屆簡章 PDF 未能自動讀取，請比對後補上「公布晉級名單」「填寫正式報名」「資格審查」等中間日期。</Todo>
    <page.Content />
  </div>
</Base>
