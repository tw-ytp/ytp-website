---
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getCollection } from 'astro:content';
import { CANON, isCanon } from '../../lib/tags';
const all = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year || (a.data.rank || 9) - (b.data.rank || 9) || a.id.localeCompare(b.id));
const editions = [...new Set(all.filter(p => p.data.source === 'stage2-project').map(p => p.data.edition))].sort((a, b) => b - a);
const events = [...new Set(all.filter(p => p.data.source !== 'stage2-project').map(p => `${p.data.source}:${p.data.event}`))].sort().reverse();
const eventLabel = (k: string) => { const [src, ev] = k.split(':'); return src === 'turing-plus' ? `YTP${ev}黑客松` : `第 ${ev} 屆黑客松`; };
const medal = ['', '金牌', '銀牌', '銅牌', '佳作'];
const rankLabel = ['', '第一名', '第二名', '第三名'];
// 篩選列的技術標籤：只列正規標籤（src/lib/tags.ts），依 CANON 順序，且至少有一筆專題
const present = new Set(all.flatMap(p => p.data.tags));
const tags = CANON.filter(t => present.has(t));
const editionKey = (p: typeof all[number]) => p.data.source !== 'stage2-project' ? `h-${p.data.source}:${p.data.event}` : String(p.data.edition);
const metaLine = (p: typeof all[number]) => p.data.source !== 'stage2-project'
  ? `${eventLabel(`${p.data.source}:${p.data.event}`)}・${p.data.group === 'youth' ? '青年組' : '高中組'}`
  : `第 ${p.data.edition} 屆・${p.data.year}`;
---
<Base title="歷屆成果" description="YTP 少年圖靈計畫歷屆專題資料庫：AI、區塊鏈、資安、教育科技……高中生用半年時間做出的作品，依屆次與技術篩選。">
  <Banner image="projects" title="歷屆成果" lead={`${all.length} 件作品：第 1 屆至今的專題實作，以及 YTP 黑客松的得獎作品。`} />
  <div class="wrap" data-pagefind-ignore>
    <FilterBar key="edition" label="依屆次" allLabel="全部屆次" list="plist" empty="empty"
      options={[...events.map(e => [`h-${e}`, eventLabel(e)] as [string, string]), ...editions.map(e => [String(e), `第 ${e} 屆`] as [string, string])]} />
    <FilterBar key="tag" label="依技術" allLabel="全部技術" list="plist" empty="empty"
      options={tags.map(t => [t, t] as [string, string])} />
    <p class="meta filter-count">顯示 <b id="plist-count">{all.length}</b> 件</p>
    <ul class="cards" id="plist">
      {all.map(p => (
        <li class={`card card-${p.data.source}`} data-edition={editionKey(p)} data-tag={p.data.tags.filter(isCanon).join('|')}>
          <a class="card-link" href={`/projects/${p.id}/`}>
            <div class="card-head">
              <span class="meta">{metaLine(p)}</span>
              {p.data.rank > 0 && <span class="rank">{p.data.source !== 'stage2-project' ? medal[p.data.rank] : rankLabel[p.data.rank]}</span>}
              {p.data.status === 'todo' && <span class="tag">待補</span>}
            </div>
            <h3 class="card-title" transition:name={`project-title-${p.id}`}>{p.data.title}</h3>
            <p class="meta card-team">{[p.data.team, p.data.members.map(m => `${m.name}（${m.school}）`).join('、')].filter(Boolean).join('｜') || ' '}</p>
            <div class="card-tags">{p.data.tags.map(t => <span class="tag">{t}</span>)}</div>
          </a>
        </li>
      ))}
    </ul>
    <p class="muted small" id="empty" hidden>沒有符合的專題。</p>
  </div>
</Base>
