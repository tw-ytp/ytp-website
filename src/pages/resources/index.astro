---
/** 備賽資源首頁。考古題與講解兩欄為動態資料；練習平台、社群文字來自 src/content/pages/resources.md。 */
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import { getCollection } from 'astro:content';
import exams from '../../data/exams.json';
import { getPage } from '../../lib/pages';
const hub = (await getCollection('hub')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id));
const latest = exams.items.filter(e => e.url).slice(0, 4);
const page = await getPage('resources');
---
<Base title={page.title} description={page.description}>
  <Banner image={page.banner} title={page.title} lead={page.lead} />
  <section class="section">
    <div class="wrap grid c2">
      <div>
        <h2>考古題</h2>
        <p>2016 年起，線上初賽與程式挑戰營的題目 PDF，依年份與組別整理。</p>
        <ul class="list">
          {latest.map(e => <li><a href={e.url}>{e.year} {e.group === 'senior' ? '高中組' : '國中組'} {e.stage === 'camp' ? '程式挑戰營' : '線上初賽'}（{e.lang}）</a></li>)}
        </ul>
        <div class="btn-row"><a class="btn ghost" href="/resources/past-exams/">全部考古題</a></div>
      </div>
      <div>
        <h2>題目講解與指南</h2>
        <ul class="list">
          {hub.map(h => <li><span class="meta">{h.data.type === 'video' ? '影片' : h.data.type === 'guide' ? '指南' : '解析'}</span><br/><a href={`/resources/solutions/#${h.id}`}>{h.data.title}</a>{h.data.status === 'todo' && <span class="tag">待補</span>}</li>)}
        </ul>
        <div class="btn-row"><a class="btn ghost" href="/resources/solutions/">全部講解</a></div>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap prose">
      <page.Content />
    </div>
  </section>
</Base>
