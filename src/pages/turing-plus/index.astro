---
import Base from '../../layouts/Base.astro';
import TrackBadge from '../../components/TrackBadge.astro';
import Banner from '../../components/Banner.astro';
import { getCollection } from 'astro:content';
import { fmtRange } from '../../lib/cohort';
import { getPage } from '../../lib/pages';
const page = await getPage('turing-plus');   // Banner 文案與「參加資格」來自 src/content/pages/turing-plus.md
const all = (await getCollection('turingPlus')).sort((a, b) => a.id.localeCompare(b.id));
const round = (id: string) => all.findIndex(h => h.id === id) + 1;
const stateLabel = { archived: '已結束', upcoming: '即將舉行', planning: '籌備中' };
const winners = (await getCollection('projects', p => p.data.source === 'turing-plus')).sort((a, b) => b.data.event!.localeCompare(a.data.event!) || a.data.rank - b.data.rank);
const medal = ['', '金牌', '銀牌', '銅牌', '佳作'];
const first = all[0]?.id, last = all.at(-1)?.id;
---
<Base title={page.title} brand="YTP 少年圖靈計畫" description={page.description}>
  <Banner image={page.banner} track="plus" title={page.title} lead={page.lead}>
    <TrackBadge slot="crumb" track="plus" />
  </Banner>
  <section class="section">
    <div class="wrap">
      <h2>{first === last ? first : `${first}–${last}`} 活動</h2>
      <ul class="list">
        {[...all].reverse().map(h => (
          <li>
            <span class="meta">第 {round(h.id)} 場｜{h.data.label}｜{stateLabel[h.data.state]}</span><br/>
            <a href={`/turing-plus/${h.id}/`}><b>{h.data.title}</b></a>
            {h.data.tagline && <div class="meta">{h.data.tagline}</div>}
            <div class="meta">{h.data.start ? fmtRange(h.data.start, h.data.end) : h.data.period}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap prose">
      <page.Content />
    </div>
  </section>
  {winners.length > 0 && <section class="section">
    <div class="wrap">
      <h2>歷屆得獎作品</h2>
      <ul class="list">
        {winners.map(p => <li><span class="meta">YTP{p.data.event}黑客松｜{p.data.group === 'youth' ? '青年組' : '高中組'}｜{medal[p.data.rank]}</span><br/><a href={`/projects/${p.id}/`}>{p.data.title}</a> <span class="meta">— {p.data.team}</span></li>)}
      </ul>
    </div>
  </section>}
</Base>
